---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';

interface Props {
  title?: string;
  hero?: string;
  description?: string;
  ogImage?: string;
}

const { title, hero, description, ogImage } = Astro.props;

// Use custom OG image if provided, otherwise use hero image
const finalOgImage = ogImage || hero;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={finalOgImage}
>
  <Header client:idle />

  <main class="page-layout">
    <div class="page-content">
      {title && <h1>{title}</h1>}
      <div class="prose">
        <slot />
      </div>
    </div>
  </main>

  <Footer client:idle />
</BaseLayout>

<style>
  .page-layout {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 2rem 6rem;
  }

  .page-content h1 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 3rem;
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 2rem 0;
    color: var(--text-primary);
    border: none;
    background: none;
    box-shadow: none;
    padding: 0;
    text-transform: none;
    letter-spacing: normal;
  }

  .prose {
    line-height: 1.8;
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .page-layout {
      padding: 3rem 1.5rem 4rem;
    }

    .page-content h1 {
      font-size: 2.25rem;
    }
  }
</style>
