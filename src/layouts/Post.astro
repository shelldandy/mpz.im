---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';

interface Props {
  title: string;
  date: Date;
  hero?: string;
  description?: string;
  ogImage?: string;
}

const { title, date, hero, description, ogImage } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(date);

// Use custom OG image if provided, otherwise use hero image, otherwise use default
const finalOgImage = ogImage || hero;
// Use custom description if provided, otherwise include post title in fallback
const finalDescription = description || `Read "${title}" on Miguel Palau's blog`;
---

<BaseLayout
  title={title}
  description={finalDescription}
  ogImage={finalOgImage}
  ogType="article"
>
  {hero && (
    <link slot="head" rel="preload" as="image" href={hero} fetchpriority="high" />
  )}
  <Header client:idle />

  <main class="post-layout">
    {hero && (
      <div class="hero">
        <img src={hero} alt={title} fetchpriority="high" />
      </div>
    )}

    <article class="post-content">
      <header class="post-header">
        <h1>{title}</h1>
        <time datetime={date.toISOString()}>{formattedDate}</time>
      </header>

      <div class="prose">
        <slot />
      </div>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .post-layout {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    overflow-x: hidden;
  }

  .hero {
    margin: -2rem -1.5rem 2rem;
    max-height: 400px;
    overflow: hidden;
    border-radius: 16px;
    margin-left: 0;
    margin-right: 0;
  }

  .hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
  }

  .post-header {
    margin-bottom: 2rem;
  }

  .post-header h1 {
    font-family: 'Trebuchet MS', 'Gill Sans', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin: 0 0 0.75rem 0;
    color: var(--text-primary);
    border: none;
    background: none;
    box-shadow: none;
    padding: 0;
    text-transform: none;
  }

  .post-header time {
    color: var(--text-secondary);
    font-family: 'Courier New', monospace;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-weight: 400;
  }

  .prose {
    line-height: 1.7;
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .post-header h1 {
      font-size: 2rem;
    }
  }
</style>
