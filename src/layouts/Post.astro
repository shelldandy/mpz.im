---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';

interface Props {
  title: string;
  date: Date;
  hero?: string;
  description?: string;
  ogImage?: string;
}

const { title, date, hero, description, ogImage } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(date);

// Use custom OG image if provided, otherwise use hero image, otherwise use default
const finalOgImage = ogImage || hero;
// Use custom description if provided, otherwise include post title in fallback
const finalDescription = description || `Read "${title}" on Miguel Palau's blog`;
---

<BaseLayout
  title={title}
  description={finalDescription}
  ogImage={finalOgImage}
  ogType="article"
>
  <Header client:idle />

  <main class="post-layout">
    <article class="post-content">
      <header class="post-header">
        <h1>{title}</h1>
        <time datetime={date.toISOString()}>{formattedDate}</time>
      </header>

      <div class="prose">
        <slot />
      </div>
    </article>
  </main>

  <Footer client:idle />
</BaseLayout>

<style>
  .post-layout {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 2rem 6rem;
    overflow-x: hidden;
  }

  .post-header {
    margin-bottom: 3rem;
  }

  .post-header h1 {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 3rem;
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 0.75rem 0;
    color: var(--text-primary);
    border: none;
    background: none;
    box-shadow: none;
    padding: 0;
    text-transform: none;
    letter-spacing: normal;
  }

  .post-header time {
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    letter-spacing: 0.05em;
  }

  .prose {
    line-height: 1.8;
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .post-layout {
      padding: 3rem 1.5rem 4rem;
    }

    .post-header h1 {
      font-size: 2.25rem;
    }
  }
</style>
