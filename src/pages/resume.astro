---
import { getEntry } from 'astro:content';
import Page from '../layouts/Page.astro';

const resumePage = await getEntry('pages', 'resume');
const { Content } = await resumePage.render();
const { title, description, ogImage, hero } = resumePage.data;
---

<Page
  title={title}
  description={description}
  ogImage={ogImage}
  hero={hero}
>
  <div class="resume-content">
    <Content />
  </div>
</Page>

<style>
  .resume-content {
    color: var(--text-primary);
  }

  .resume-content :global(a) {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .resume-content :global(a:hover) {
    text-decoration: underline;
  }

  .resume-content :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
    font-weight: 700;
    font-size: 2rem;
  }

  .resume-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
    font-weight: 600;
    font-size: 1.5rem;
  }

  .resume-content :global(h3 a) {
    color: var(--accent);
    text-decoration: none;
  }

  .resume-content :global(h3 a:hover) {
    text-decoration: underline;
  }

  .resume-content :global(strong) {
    color: var(--text-primary);
    font-weight: 700;
  }

  .resume-content :global(em) {
    color: var(--text-secondary);
    font-style: italic;
  }

  .resume-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 3rem 0;
  }

  .resume-content :global(ul) {
    list-style: none;
    padding-left: 0;
  }

  .resume-content :global(li) {
    padding-left: 1.5rem;
    position: relative;
    margin-bottom: 0.5rem;
  }

  .resume-content :global(li::before) {
    content: "\25B8";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-size: 1em;
  }

  .resume-content :global(p:first-of-type a) {
    display: inline-flex;
    align-items: center;
    padding: 12px 24px;
    background: var(--accent);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.2s ease;
    text-decoration: none;
    margin-bottom: 2rem;
  }

  .resume-content :global(p:first-of-type a:hover) {
    opacity: 0.9;
    text-decoration: none;
  }
</style>
