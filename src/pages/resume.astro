---
import { getEntry } from 'astro:content';
import Page from '../layouts/Page.astro';

const resumePage = await getEntry('pages', 'resume');
const { Content } = await resumePage.render();
const { title, description, ogImage, hero } = resumePage.data;
---

<Page
  title={title}
  description={description}
  ogImage={ogImage}
  hero={hero}
>
  <div class="resume-content">
    <Content />
  </div>
</Page>

<style>
  .resume-content {
    color: var(--text-primary);
  }

  .resume-content :global(a) {
    color: var(--accent);
    text-decoration: none;
    border: none;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .resume-content :global(a:hover) {
    text-decoration: underline;
    background: transparent;
    color: var(--accent);
  }

  .resume-content :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    padding: 0;
    border: none;
    background: none;
    box-shadow: none;
    color: var(--text-primary);
    font-family: 'Trebuchet MS', 'Gill Sans', sans-serif;
    font-weight: 600;
    text-transform: none;
    letter-spacing: -0.04em;
    background-image: var(--gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .resume-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    padding: 0;
    border: none;
    background: none;
    box-shadow: none;
    color: var(--text-primary);
    font-family: 'Trebuchet MS', 'Gill Sans', sans-serif;
    font-weight: 600;
    text-transform: none;
  }

  .resume-content :global(h3 a) {
    color: var(--accent);
    border: none;
    text-decoration: none;
    -webkit-text-fill-color: var(--accent);
  }

  .resume-content :global(h3 a:hover) {
    background: transparent;
    color: var(--accent);
    text-decoration: underline;
  }

  .resume-content :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .resume-content :global(em) {
    color: var(--text-secondary);
    font-style: normal;
    font-weight: 400;
  }

  .resume-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 3rem 0;
  }

  .resume-content :global(ul) {
    list-style: none;
    padding-left: 0;
  }

  .resume-content :global(li) {
    padding-left: 1.5rem;
    position: relative;
    margin-bottom: 0.75rem;
    font-weight: 400;
  }

  .resume-content :global(li::before) {
    content: "\25B8";
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 400;
    font-size: 1em;
  }

  .resume-content :global(p:first-of-type a) {
    display: inline-block;
    padding: 12px 28px;
    background: var(--gradient);
    color: white;
    border: none;
    border-radius: 100px;
    font-weight: 600;
    box-shadow: none;
    transition: all 0.2s ease;
    text-decoration: none;
    margin-bottom: 2rem;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
  }

  .resume-content :global(p:first-of-type a:hover) {
    opacity: 0.9;
    transform: translateY(-1px);
    background: var(--gradient);
    color: white;
    text-decoration: none;
  }
</style>
