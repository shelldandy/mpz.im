---
import { getEntry } from 'astro:content';
import Page from '../layouts/Page.astro';

const resumePage = await getEntry('pages', 'resume');
const { Content } = await resumePage.render();
const { title, description, ogImage, hero } = resumePage.data;
---

<Page
  title={title}
  description={description}
  ogImage={ogImage}
  hero={hero}
>
  <div class="resume-content">
    <Content />
  </div>
</Page>

<style>
  .resume-content {
    color: var(--text-primary);
  }

  .resume-content :global(a) {
    color: var(--accent);
    text-decoration: none;
    border: none;
    transition: color 0.2s ease;
  }

  .resume-content :global(a:hover) {
    color: var(--accent);
    text-decoration: underline;
    background: transparent;
  }

  .resume-content :global(h2) {
    font-family: Georgia, 'Times New Roman', serif;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    padding: 0;
    border: none;
    background: none;
    box-shadow: none;
    color: var(--text-primary);
    font-weight: 400;
    font-size: 2rem;
    text-transform: none;
    letter-spacing: normal;
  }

  .resume-content :global(h3) {
    font-family: Georgia, 'Times New Roman', serif;
    margin-top: 2rem;
    margin-bottom: 1rem;
    padding: 0;
    border: none;
    background: none;
    box-shadow: none;
    color: var(--text-primary);
    font-weight: 700;
    font-size: 1.5rem;
    text-transform: none;
  }

  .resume-content :global(h3 a) {
    color: var(--accent);
    border: none;
    text-decoration: none;
  }

  .resume-content :global(h3 a:hover) {
    background: transparent;
    color: var(--accent);
    text-decoration: underline;
  }

  .resume-content :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .resume-content :global(em) {
    color: var(--text-secondary);
    font-style: italic;
  }

  .resume-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 3rem 0;
  }

  .resume-content :global(ul) {
    list-style: none;
    padding-left: 0;
  }

  .resume-content :global(li) {
    padding-left: 1.5rem;
    position: relative;
    margin-bottom: 0.75rem;
  }

  .resume-content :global(li::before) {
    content: "\2013";
    position: absolute;
    left: 0;
    color: var(--text-secondary);
    font-weight: 400;
  }

  .resume-content :global(p:first-of-type a) {
    display: inline-block;
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    border: none;
    background: transparent;
    box-shadow: none;
    padding: 0;
    margin-bottom: 2rem;
    text-transform: none;
  }

  .resume-content :global(p:first-of-type a:hover) {
    text-decoration: underline;
    background: transparent;
    color: var(--accent);
    transform: none;
    box-shadow: none;
  }
</style>
